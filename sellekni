#!/usr/bin/env bash
# SELLEKNI local runner — start, stop, check and test everything with one command.
#
#   ./sellekni up [--prod] [--mobile] [--replace]
#                                    Docker/colima → Supabase → env + demo logins → web app (dev, or build+start)
#                                    --replace: stop another `next dev` already running for apps/web (one per folder)
#   ./sellekni open [--reset] [--dev|--prod] [--locale=ar|fr|en] [--no-stage]
#                                    everything in one go: starts what is missing (production build by default,
#                                    rebuilt when the code changed), sets up USB phones (adb, newer APK), checks
#                                    readiness, then Chrome already signed in: dispatcher + hospital A + stage
#   ./sellekni login                    print the demo accounts and password
#   ./sellekni status                   what is running, on which port
#   ./sellekni reset                    empty the demo database (incidents, pre-alerts, audit)
#   ./sellekni test                     pnpm check + the e2e hero flow against the running app
#   ./sellekni logs [web|mobile]        follow a log
#   ./sellekni down [--all]             stop what this script started (--all: Supabase too)
#
# Env: PORT (default: first free from 3000), BASE_URL (skip starting: test/open an app already running there).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN="$ROOT/.sellekni"            # pids, logs, chosen port (gitignored)
ENV_FILE="$ROOT/.env.local"
mkdir -p "$RUN"

if [[ -t 1 ]]; then B=$'\e[1m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; D=$'\e[2m'; N=$'\e[0m'; else B= G= Y= R= D= N=; fi
say()  { printf '%s\n' "${B}▸${N} $*"; }
ok()   { printf '%s\n' "  ${G}✓${N} $*"; }
warn() { printf '%s\n' "  ${Y}!${N} $*"; }
die()  { printf '%s\n' "  ${R}✗${N} $*" >&2; exit 1; }

# value of KEY in .env.local, without an inline "# comment"
envget() { [[ -f "$ENV_FILE" ]] && grep -E "^$1=" "$ENV_FILE" | tail -1 | cut -d= -f2- | sed -E 's/[[:space:]]+#.*$//; s/^"(.*)"$/\1/' || true; }
# hospital id of a demo login for the active HOSPITAL_SET (data/demo-hospitals.json)
demo_hospital() { node -e 'const set=process.argv[2]==="demo"?"demo":"national";console.log(require(process.argv[1]).logins[set][process.argv[3]])' "$ROOT/data/demo-hospitals.json" "$(envget HOSPITAL_SET)" "$1"; }

port_busy() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }
# spawn NAME DIR CMD…: detached, all three streams redirected (so `./sellekni up | tee` ends), pid in .sellekni/NAME.pid
spawn() {
  local name="$1" dir="$2"; shift 2
  (cd "$dir" && exec nohup "$@" >"$RUN/$name.log" 2>&1 </dev/null) &
  echo $! >"$RUN/$name.pid"
}
pid_alive() { [[ -f "$RUN/$1.pid" ]] && kill -0 "$(cat "$RUN/$1.pid")" 2>/dev/null; }
base_url() {
  if [[ -n "${BASE_URL:-}" ]]; then echo "$BASE_URL"
  elif [[ -f "$RUN/web.port" ]]; then echo "http://localhost:$(cat "$RUN/web.port")"
  else echo "http://localhost:${PORT:-3000}"; fi
}
healthy() { curl -fsS -m 3 "$1/api/health" >/dev/null 2>&1; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed. $2"; }

# ───────────────────────── steps ─────────────────────────

check_tools() {
  say "Tools"
  need node "Install Node 22+ (see .nvmrc)."
  need pnpm "Run: corepack enable"
  need docker "Install Docker Desktop or colima (brew install colima docker)."
  need supabase "Run: brew install supabase/tap/supabase"
  ok "node $(node -v) · pnpm $(pnpm -v) · supabase $(supabase --version 2>/dev/null | head -1)"
}

start_docker() {
  say "Docker"
  if docker info >/dev/null 2>&1; then ok "running"; return; fi
  if command -v colima >/dev/null 2>&1; then
    warn "not running — starting colima (≈ 30 s)"
    colima start >/dev/null
    docker info >/dev/null 2>&1 && ok "colima started" || die "colima did not start: run 'colima start' and read its output"
  else
    die "Docker is not running. Open Docker Desktop, then run ./sellekni up again."
  fi
}

install_deps() {
  say "Dependencies"
  if [[ ! -d "$ROOT/node_modules" || "$ROOT/pnpm-lock.yaml" -nt "$ROOT/node_modules/.modules.yaml" ]]; then
    (cd "$ROOT" && pnpm install --frozen-lockfile) && ok "installed"
  else
    ok "up to date"
  fi
}

start_supabase() {
  say "Supabase (Postgres + Auth + Realtime)"
  if (cd "$ROOT" && supabase status >/dev/null 2>&1); then ok "already running"
  else
    (cd "$ROOT" && supabase start -x vector,logflare >"$RUN/supabase.log" 2>&1) || { tail -20 "$RUN/supabase.log"; die "supabase start failed (log: .sellekni/supabase.log)"; }
    ok "started"
  fi
  ok "Studio: http://127.0.0.1:54323 · e-mails: http://127.0.0.1:54324"
}

prepare_env_and_users() {
  say "Environment + demo logins"
  (cd "$ROOT" && pnpm -s env:local >/dev/null) && ok ".env.local filled (only empty keys)"
  [[ "$(envget DEMO_MODE)" == "true" ]] || warn "DEMO_MODE is not 'true' in .env.local: Simulate SMS, /demo and /phones are hidden"
  (cd "$ROOT" && pnpm -s db:users >"$RUN/users.log" 2>&1) || { cat "$RUN/users.log"; die "could not create the demo logins"; }
  ok "dispatcher@sellekni.test · hospital-a@sellekni.test · hospital-b@sellekni.test"
}

# pid of a `next dev` started elsewhere for this same app (Next 16 allows only one dev server per folder)
other_dev_pid() {
  local pid
  for pid in $(pgrep -f "next dev|next-server" 2>/dev/null); do
    [[ -f "$RUN/web.pid" ]] && pgrep -P "$(cat "$RUN/web.pid")" 2>/dev/null | grep -qx "$pid" && continue
    if [[ "$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')" == "$ROOT/apps/web" ]] \
       && lsof -a -p "$pid" -iTCP -sTCP:LISTEN >/dev/null 2>&1 \
       && ps -o command= -p "$pid" | grep -qv "next start"; then
      echo "$pid"; return
    fi
  done
}

pick_port() {
  local p="${PORT:-3000}"
  if [[ -n "${PORT:-}" ]]; then port_busy "$p" && die "port $p is busy (lsof -nP -iTCP:$p -sTCP:LISTEN)"; echo "$p"; return; fi
  while port_busy "$p"; do p=$((p + 1)); [[ $p -gt 3020 ]] && die "no free port between 3000 and 3020"; done
  echo "$p"
}

start_web() {
  local mode="$1" port
  say "Web app (Next.js, $mode)"
  if pid_alive web && healthy "$(base_url)"; then ok "already running at $(base_url)"; return; fi
  port="$(pick_port)"
  [[ "$port" != "3000" ]] && warn "port 3000 is busy → using $port"
  echo "$port" >"$RUN/web.port"
  if [[ "$mode" == "prod" ]]; then
    (cd "$ROOT" && pnpm --filter web build >"$RUN/build.log" 2>&1) || { tail -30 "$RUN/build.log"; die "build failed (log: .sellekni/build.log)"; }
    ok "built"
    spawn web "$ROOT/apps/web" pnpm exec next start -p "$port"
  else
    local other; other="$(other_dev_pid || true)"
    if [[ -n "$other" ]]; then
      local oport; oport="$(lsof -a -p "$other" -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {sub(/.*:/,"",$9); print $9; exit}')"
      if [[ "$REPLACE" == 1 ]]; then
        warn "stopping the other next dev (pid $other, port $oport)"
        kill -TERM "$other" 2>/dev/null || true; sleep 2
      else
        rm -f "$RUN/web.port"
        die "another 'next dev' already runs for apps/web (pid $other, http://localhost:$oport). Next allows one per folder.
      Choose one:  ./sellekni up --replace     (stop it and start a fresh one)
                   ./sellekni up --prod        (production build on another port, runs alongside)
                   BASE_URL=http://localhost:$oport ./sellekni open   (use that one as is)"
      fi
    fi
    spawn web "$ROOT/apps/web" pnpm dev -p "$port"
  fi
  printf '  waiting for http://localhost:%s ' "$port"
  for _ in $(seq 1 90); do
    if healthy "http://localhost:$port"; then
      echo; ok "up at http://localhost:$port"
      # warm the first page so the first click is not a 10 s dev compile
      curl -s -o /dev/null -m 60 "http://localhost:$port/login" || true
      return
    fi
    pid_alive web || { echo; tail -30 "$RUN/web.log"; die "web app exited (log: .sellekni/web.log)"; }
    printf '.'; sleep 1
  done
  echo; tail -20 "$RUN/web.log"; die "web app did not answer /api/health within 90 s (log: .sellekni/web.log)"
}

start_mobile() {
  say "Mobile (Expo Metro for the development build)"
  if pid_alive mobile; then ok "already running"; return; fi
  spawn mobile "$ROOT" pnpm dev:mobile
  ok "Metro starting (log: ./sellekni logs mobile). Open the SELLEKNI dev build on the phone — NOT Expo Go."
  warn "first install on a phone: pnpm --filter mobile android (USB debugging on)"
}

print_login() {
  local url pw
  url="$(base_url)"; pw="$(envget DEMO_USER_PASSWORD)"
  [[ -n "$pw" ]] || die "DEMO_USER_PASSWORD is empty: run ./sellekni up"
  cat <<EOF

${B}SELLEKNI is ready${N}  ${D}(synthetic data only)${N}

  Open           ${B}$url/login${N}
  Password       ${B}$pw${N}   ${D}(same for every demo account, from .env.local)${N}

  Dispatcher     dispatcher@sellekni.test    → $url/
  Hospital A     hospital-a@sellekni.test    → $url/hospital/$(demo_hospital hospital-a)
  Hospital B     hospital-b@sellekni.test    → $url/hospital/$(demo_hospital hospital-b)

  ${D}Use one normal window for the dispatcher and a private window for the hospital (separate sessions),${N}
  ${D}or let the script do it:${N}  ${B}./sellekni open${N}

  Audit log      $url/audit
  Styleguide     $url/styleguide       (no login)
  Supabase       http://127.0.0.1:54323 (Studio)
EOF
}

stop_pid() {
  local name="$1"
  if pid_alive "$name"; then
    local pid; pid="$(cat "$RUN/$name.pid")"
    pkill -TERM -P "$pid" 2>/dev/null || true   # pnpm's child (next / expo)
    kill -TERM "$pid" 2>/dev/null || true
    ok "$name stopped"
  fi
  rm -f "$RUN/$name.pid"
}

# ───────────────────────── commands ─────────────────────────

cmd_up() {
  local mode=dev mobile=0
  REPLACE=0
  for a in "$@"; do case "$a" in --prod) mode=prod ;; --mobile) mobile=1 ;; --replace) REPLACE=1 ;; *) die "unknown option $a" ;; esac; done
  check_tools; start_docker; install_deps; start_supabase; prepare_env_and_users
  start_web "$mode"
  [[ $mobile == 1 ]] && start_mobile
  print_login
}

cmd_status() {
  local url; url="$(base_url)"
  say "Status"
  docker info >/dev/null 2>&1 && ok "docker" || warn "docker: not running"
  (cd "$ROOT" && supabase status >/dev/null 2>&1) && ok "supabase: running (API 127.0.0.1:54321)" || warn "supabase: stopped"
  if healthy "$url"; then ok "web: $url  $(curl -s -m 3 "$url/api/health")"; else warn "web: nothing healthy at $url"; fi
  pid_alive mobile && ok "mobile Metro: running" || true
  local others; others="$(lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk '/node|next/ {print $9}' | grep -oE ':(30[0-9][0-9]|3100)$' | sort -u | tr '\n' ' ' || true)"
  [[ -n "$others" ]] && printf '  %s\n' "${D}node servers listening on ports:${N} $others"
}

cmd_reset() {
  local url; url="$(base_url)"
  healthy "$url" || die "no app at $url (./sellekni up first)"
  (cd "$ROOT/apps/web" && BASE_URL="$url" pnpm -s exec tsx scripts/open-demo.mts --reset-only)
}

# a source file is newer than the production build: the running `next start` would show old code
build_stale() {
  local id="$ROOT/apps/web/.next/BUILD_ID"
  [[ -f "$id" ]] || return 0
  [[ -n "$(find "$ROOT/apps/web/src" "$ROOT/apps/web/messages" "$ROOT/apps/web/public" "$ROOT/apps/web/next.config.ts" \
    "$ROOT/packages" -newer "$id" -type f -not -path '*/node_modules/*' -not -path '*/test/*' -not -name '*.md' \
    -print -quit 2>/dev/null)" ]]
}
web_mode() { ps -o command= -p "$(cat "$RUN/web.pid" 2>/dev/null || echo 0)" 2>/dev/null | grep -q "next start" && echo prod || echo dev; }

# start what is missing; restart the web app when it runs in the other mode or its production build is out of date
ensure_web() {
  local want="$1"
  check_tools; start_docker; install_deps; start_supabase
  if pid_alive web && healthy "$(base_url)"; then
    local have; have="$(web_mode)"
    if [[ -n "$want" && "$want" != "$have" ]]; then
      warn "web app runs in $have mode → restarting in $want"; stop_pid web; rm -f "$RUN/web.port"
    elif [[ "$have" == prod ]] && build_stale; then
      warn "code changed since the last production build → rebuilding"; stop_pid web; rm -f "$RUN/web.port"; want=prod
    else
      say "Web app"; ok "already running at $(base_url) ($have, up to date)"; return
    fi
  elif healthy "$(base_url)"; then
    say "Web app"; warn "an app this script did not start answers at $(base_url): using it as is (./sellekni down, then open, to own it)"; return
  fi
  prepare_env_and_users
  start_web "${want:-prod}"
}

# USB phones: the app's server URL is http://127.0.0.1:3000 (adb reverse to the web port); the SMS Gateway app's local
# server is reached at 127.0.0.1:8080 (adb forward). Installs the release APK when it is newer than the installed app.
setup_phones() {
  local port="${1##*:}" apk="$ROOT/apps/mobile/android/app/build/outputs/apk/release/app-release.apk" serials s gw_done=0
  say "Phones (USB)"
  command -v adb >/dev/null 2>&1 || { ok "adb not installed: skipped (the virtual phones on /phones need no device)"; return 0; }
  serials="$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device" {print $1}')"
  [[ -n "$serials" ]] || { ok "none connected (plug one in with USB debugging on, then run open again)"; return 0; }
  if [[ -f "$apk" && -n "$(find "$ROOT/apps/mobile/app" "$ROOT/apps/mobile/src" "$ROOT/apps/mobile/modules" "$ROOT/packages" \
      -newer "$apk" -type f -not -path '*/node_modules/*' -not -path '*/build/*' -not -path '*/test/*' -not -name '*.md' -print -quit 2>/dev/null)" ]]; then
    warn "the APK is older than the mobile code: cd apps/mobile/android && ./gradlew assembleRelease, then open again"
  fi
  for s in $serials; do
    local model pkgs roles=""
    model="$(adb -s "$s" shell getprop ro.product.model 2>/dev/null | tr -d '\r')"
    pkgs="$(adb -s "$s" shell pm list packages 2>/dev/null | tr -d '\r')"
    adb -s "$s" reverse tcp:3000 tcp:"$port" >/dev/null && roles="app → 127.0.0.1:3000 = laptop :$port"
    if [[ -f "$apk" ]]; then
      local installed=0 when
      if grep -qx 'package:com.sellekni.app' <<<"$pkgs"; then
        when="$(adb -s "$s" shell dumpsys package com.sellekni.app 2>/dev/null | sed -n 's/.*lastUpdateTime=//p' | head -1 | tr -d '\r')"
        installed="$(date -j -f '%Y-%m-%d %H:%M:%S' "$when" +%s 2>/dev/null || echo 0)"
      fi
      if (( $(stat -f %m "$apk") > installed + 60 )); then
        printf '  installing the release APK on %s (≈ 20 s) ' "$model"
        adb -s "$s" install -r "$apk" >/dev/null 2>&1 && echo "✓" || { echo; warn "install failed on $model: adb -s $s install -r $apk"; }
      fi
    fi
    grep -qx 'package:com.sellekni.app' <<<"$(adb -s "$s" shell pm list packages com.sellekni.app 2>/dev/null | tr -d '\r')" \
      || roles="$roles · ${Y}Sellekni app not installed${N}"
    if grep -qx 'package:me.capcom.smsgateway' <<<"$pkgs" && [[ $gw_done == 0 ]]; then
      adb -s "$s" forward tcp:8080 tcp:8080 >/dev/null && roles="$roles · SMS gateway → laptop 127.0.0.1:8080" && gw_done=1
      # a dozing phone answers 500: wake it and bring the gateway app to the front (some phones, e.g. Realme, refuse
      # injected input over USB; preflight then says to do it by hand)
      adb -s "$s" shell input keyevent KEYCODE_WAKEUP >/dev/null 2>&1 || true
      adb -s "$s" shell monkey -p me.capcom.smsgateway -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 || true
    fi
    ok "$model ($s): $roles"
  done
}

# what the stage needs, in one glance (read-only; scripts/reset-demo.sh does the full reset + checklist)
preflight() {
  local url="$1" resetting="$2" health db open_inc gw others
  say "Ready check"
  health="$(curl -fsS -m 5 "$url/api/health" || true)"
  grep -q '"demo":true' <<<"$health" && ok "DEMO_MODE on: Simulate SMS, /demo, /phones" || warn "DEMO_MODE off: no Simulate SMS, /demo or /phones"
  grep -q '"offlineTiles":true' <<<"$health" && ok "offline map tiles" || warn "no offline tiles: the map needs internet"
  db="$(cd "$ROOT" && supabase status -o env 2>/dev/null | sed -n 's/^DB_URL="\(.*\)"$/\1/p')"
  if command -v psql >/dev/null 2>&1 && [[ -n "$db" ]]; then
    ok "hospitals: $(psql "$db" -Atc 'select count(*) from public.hospitals' 2>/dev/null || echo '?') (HOSPITAL_SET=$(envget HOSPITAL_SET))"
    open_inc="$(psql "$db" -Atc "select count(*) from public.incidents where status not in ('CLOSED','CANCELLED','MERGED')" 2>/dev/null || echo '?')"
    if [[ "$resetting" == 1 ]]; then ok "open incidents: $open_inc → emptied by --reset below"
    elif [[ "$open_inc" == 0 ]]; then ok "no open incident: clean stage"
    else warn "$open_inc open incident(s): add --reset for a clean stage"; fi
  fi
  if [[ -n "$(envget PUBLIC_BASE_URL)" ]]; then ok "witness/crew QR codes use PUBLIC_BASE_URL=$(envget PUBLIC_BASE_URL)"
  else ok "witness/crew QR codes use $url: phones on USB open them (adb reverse); Wi-Fi phones need PUBLIC_BASE_URL"; fi
  case "$(envget SMSGATE_MODE)" in
    local) gw="$(envget SMSGATE_BASE_URL)"
      local tries=0; until curl -fsS -m 3 -u "$(envget SMSGATE_USER):$(envget SMSGATE_PASSWORD)" "$gw/health" >/dev/null 2>&1 || (( ++tries > 5 )); do sleep 1; done
      if (( tries <= 5 )); then ok "SMS gateway phone answers at $gw"
      else warn "SMS gateway phone not reachable at $gw: unlock it and open the SMS Gateway app (local server on), cable in.
      Asleep it answers 500: Settings → Developer options → Stay awake keeps it up while charging."; fi ;;
    sim) ok "SMS gateway: simulated (nothing is really sent)" ;;
    *) warn "SMSGATE_MODE=$(envget SMSGATE_MODE)" ;;
  esac
  others="$(for p in $(pgrep -f next-server 2>/dev/null); do
      [[ "$(lsof -a -p "$p" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')" == "$ROOT/apps/web" ]] || continue
      pgrep -P "$(cat "$RUN/web.pid" 2>/dev/null || echo 0)" 2>/dev/null | grep -qx "$p" && continue
      lsof -a -p "$p" -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk -v p="$p" 'NR>1 {sub(/.*:/,"",$9); printf ":%s (pid %s) ", $9, p; exit}'
    done)"
  [[ -n "$others" ]] && warn "other servers of this app still running: $others— stop them with kill <pid> if unused"
  return 0
}

cmd_open() {
  local mode="" pass=() url resetting=0
  for a in "$@"; do case "$a" in --prod) mode=prod ;; --dev) mode=dev ;; --reset) resetting=1; pass+=("$a") ;; *) pass+=("$a") ;; esac; done
  REPLACE=0
  if [[ -n "${BASE_URL:-}" ]]; then healthy "$BASE_URL" || die "no app at $BASE_URL"
  else ensure_web "$mode"; fi
  url="$(base_url)"
  setup_phones "$url"
  preflight "$url" "$resetting"
  say "Opening Chrome: dispatcher + hospital A + stage (/demo, /phones), already signed in (close all windows to quit)"
  (cd "$ROOT/apps/web" && BASE_URL="$url" pnpm -s exec tsx scripts/open-demo.mts ${pass[@]+"${pass[@]}"})
}

cmd_test() {
  local url; url="$(base_url)"
  healthy "$url" || die "no app at $url (./sellekni up first)"
  say "Unit tests, typecheck, protocol cross-check"
  (cd "$ROOT" && pnpm check)
  say "E2E hero flow against $url (resets the demo database)"
  (cd "$ROOT/apps/web" && BASE_URL="$url" pnpm exec playwright test)
}

cmd_logs() {
  local f="$RUN/${1:-web}.log"
  [[ -f "$f" ]] || die "no log $f"
  tail -n 50 -f "$f"
}

cmd_down() {
  say "Stopping"
  stop_pid web; stop_pid mobile; rm -f "$RUN/web.port"
  if [[ "${1:-}" == "--all" ]]; then (cd "$ROOT" && supabase stop >/dev/null 2>&1) && ok "supabase stopped (data kept)"; fi
}

case "${1:-up}" in
  up) shift || true; cmd_up "$@" ;;
  login) print_login ;;
  open) shift; cmd_open "$@" ;;
  status) cmd_status ;;
  reset) cmd_reset ;;
  test) cmd_test ;;
  logs) cmd_logs "${2:-web}" ;;
  down) cmd_down "${2:-}" ;;
  -h|--help|help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (./sellekni help)" ;;
esac
