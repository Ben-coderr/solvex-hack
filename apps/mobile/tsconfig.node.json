{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["test/**/*.ts", "scripts/**/*.ts", "src/detector/**/*.ts", "src/replay/**/*.ts", "src/alert/**/*.ts", "src/brand.ts", "src/sensorlab/**/*.ts"]
}
