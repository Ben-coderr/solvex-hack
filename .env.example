# ─── Supabase (local: `supabase start` prints these) ───
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only. NEVER expose to the browser or the mobile app.
DATABASE_URL=                         # server only: direct Postgres for the transactional ingest (local: `supabase status` DB_URL)

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
LINK_SIGNING_SECRET=                  # random 32+ bytes: signs the /w witness links (and sender hashes)
PUBLIC_BASE_URL=                      # origin in witness links/QR (e.g. http://192.168.1.20:3000); empty = the dashboard's own origin
INGEST_API_KEY=                       # shared secret the mobile app sends (x-sellekni-key). Rate-limited anyway.

# ─── SMS gateway (capcom6 "SMS Gateway for Android") ───
SMSGATE_MODE=local                    # local | cloud | sim (sim = no phone, logs outbound SMS)
SMSGATE_BASE_URL=http://192.168.1.50:8080   # the phone's address in local mode (check docs.sms-gate.app)
SMSGATE_USER=
SMSGATE_PASSWORD=
SMSGATE_WEBHOOK_SECRET=               # you choose it; the inbound webhook must present it
SMSGATE_CAPTURE_DIR=                  # dev only, e.g. ../../data/captures: records each signed webhook to build fixtures

# ─── Routing ───
OSRM_URL=http://localhost:5000
ORS_API_KEY=                          # free key, fallback only (2,000 directions/day)

# ─── Demo ───
DEMO_MODE=true                        # enables /demo, /phones and the "simulate SMS" button
HOSPITAL_SET=national                 # national = 273 unverified real hospitals (default) · demo = 12 synthetic ones; then pnpm db:users
DEMO_USER_PASSWORD=                   # password of the seeded demo logins (scripts/seed-users.ts)
