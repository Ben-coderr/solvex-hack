{
  "name": "najda",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "vectors": "pnpm --filter @najda/shared vectors",
    "crosscheck": "python3 -I packages/shared/scripts/crosscheck.py",
    "tokens": "pnpm --filter @najda/tokens build",
    "check": "pnpm test && pnpm typecheck && pnpm crosscheck",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "db:seed-sql": "node scripts/gen-seed-sql.mjs",
    "db:reset": "node scripts/gen-seed-sql.mjs && supabase db reset",
    "env:local": "node scripts/env-local.mjs",
    "db:users": "tsx --env-file=.env.local scripts/seed-users.mts",
    "realtime:probe": "tsx --env-file=.env.local scripts/realtime-probe.mts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "tsx": "^4.19.0"
  }
}
